<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" styleClass="screen">
    <VBox alignment="CENTER_LEFT" spacing="16" maxWidth="520" styleClass="menu-box">
        <Label text="Un nuovo speziale" styleClass="heading"/>
        <Label text="Ogni guaritore comincia con poco: un mortaio, qualche erba e un nome che la gente imparerà a conoscere."
               styleClass="subtitle" wrapText="true"/>
        <Label text="Come ti chiami?" styleClass="subheading"/>
        <TextField fx:id="nameField" promptText="Nome dello speziale" maxWidth="Infinity"/>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button text="Indietro" onAction="#onBack" styleClass="ghost-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="startButton" text="Inizia il viaggio" onAction="#onStart" styleClass="primary-button"/>
        </HBox>
    </VBox>
</StackPane>
