<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" styleClass="screen">
    <VBox alignment="CENTER" spacing="12" maxWidth="540" styleClass="menu-box">
        <Label text="⚗" styleClass="emblem"/>
        <Label text="Lo Speziale" styleClass="title"/>
        <Label text="Un gioco di alchimia e medicina nelle terre flagellate dalla Moria Cinerea."
               styleClass="subtitle" wrapText="true" textAlignment="CENTER" maxWidth="420"/>
        <VBox alignment="CENTER" spacing="10" maxWidth="280">
            <Button text="Nuova partita" onAction="#onNewGame" styleClass="primary-button" maxWidth="Infinity"/>
            <Button fx:id="resumeButton" text="Riprendi partita" onAction="#onResume" maxWidth="Infinity"/>
            <Button text="Esci" onAction="#onQuit" styleClass="ghost-button" maxWidth="Infinity"/>
        </VBox>
    </VBox>
</StackPane>
