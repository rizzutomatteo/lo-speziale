<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" styleClass="screen">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
            <Label text="Mercato" styleClass="heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox styleClass="chip" alignment="CENTER">
                <Label fx:id="coinsLabel" styleClass="chip-text"/>
            </HBox>
            <Button text="Indietro" onAction="#onBack" styleClass="ghost-button"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10" styleClass="content">
            <Label fx:id="messageLabel" styleClass="subtitle"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="waresBox" spacing="10"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
