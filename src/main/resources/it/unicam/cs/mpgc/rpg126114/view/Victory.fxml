<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" styleClass="screen">
    <VBox alignment="CENTER" spacing="14" maxWidth="560" styleClass="menu-box">
        <Label text="✦" styleClass="emblem"/>
        <Label text="Luminare" styleClass="title"/>
        <Label fx:id="summaryLabel" styleClass="subtitle" wrapText="true" textAlignment="CENTER" maxWidth="440"/>
        <Button text="Torna al menù" onAction="#onMenu" styleClass="primary-button" maxWidth="260"/>
    </VBox>
</StackPane>
